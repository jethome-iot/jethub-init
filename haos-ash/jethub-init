#!/bin/sh

# gset [gpioset options] <line=value>...  — set line(s) and exit; the pin keeps
# the level. Lines are DT names, or offsets together with -c <chip>.
gset() {
    gpioset --toggle 0 "$@" || { echo "${0}: *** Error: gpioset $* failed"; return 1; }
}

# gpulse <name>  — drive line HIGH for 500ms, then LOW
gpulse() {
    gpioset --toggle 500ms,0 "${1}=1" || { echo "${0}: *** Error: pulse on ${1} failed"; return 1; }
}

# wait_line <name>  — wait up to 5s for a named line to appear
wait_line() {
    i=0
    while [ "${i}" -lt 50 ]; do
        gpioinfo "${1}" >/dev/null 2>&1 && return 0
        sleep 0.1
        i=$((i + 1))
    done
    echo "${0}: *** Error: gpio line '${1}' not available"
    return 1
}

. /usr/lib/jethome/libjethubconfig.sh
[ -f /etc/default/jethub ] && . /etc/default/jethub

for func in ${ADDITIONALFUNC}; do
    echo "${0}: Start additional init function ${func}"
    ${func} || echo "${0}: *** Error: ${func} failed"
done

echo "${0}: Initialization done"
exit 0
