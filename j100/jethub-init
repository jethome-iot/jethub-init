#!/bin/sh

echo "${0}: Configure LEDs ..."
# Active-low LEDs: 0 = off
gpioset --toggle 0 --active-low LedRed=0 LedGreen=0 ||
    echo "${0}: *** Error: Failed to configure LEDs"

# BOOT: 1 - application, 0 - bootloader
echo "${0}: Set Zigbee module to application mode ..."
gpioset --toggle 0 ZigBeeBOOT=1 ||
    echo "${0}: *** Error: Failed to set Zigbee module to application mode"

echo "${0}: Configure 1-Wire ..."
if modprobe ds2482; then
    # No ds2482 node in the DTS: instantiate the i2c device manually.
    sh -c "echo ds2482 0x18 > /sys/bus/i2c/devices/i2c-0/new_device" 2>/dev/null
else
    echo "${0}: *** Error: Failed to load DS2482 kernel module"
fi

echo "${0}: Initialization done"
